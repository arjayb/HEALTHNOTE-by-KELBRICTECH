<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Permissions kept to the minimum the product specification's feature set
        actually requires — no network permission, per
        HEALTHNOTE_ARCHITECTURE.md §3.7 (no network call from any core
        path). Re-verify this list against whatever the final OCR/
        camera/PDF package choices actually declare in their own
        manifests before shipping — a transitive dependency merging in
        an unwanted permission is exactly the kind of drift §3.7's
        "standing check" is meant to catch.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Deliberately NOT requesting INTERNET — local-first means this
         app should not even have the ability to make a network call
         at the OS permission level, which is a stronger guarantee
         than "the code doesn't currently call the network." -->

    <application
        android:label="HealthNote"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <!--
            allowBackup=false / fullBackupContent=false: per
            HEALTHNOTE_ARCHITECTURE.md §3.7, no unapproved backup path
            for this data — Android's auto-backup could otherwise
            silently copy the encrypted store off-device.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
